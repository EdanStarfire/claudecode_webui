  {
   "name": "plain_user_turns",
   "note": "",
   "archive": false,
   "records": [
    {
     "type": "user",
     "message_id": "m1",
     "content": "hello"
    },
    {
     "type": "assistant",
     "message_id": "m2",
     "content": "ok",
     "metadata": {
      "tool_uses": []
     }
    },
    {
     "type": "user",
     "message_id": "m3",
     "content": "again"
    }
   ],
   "expected": {
    "turns": [
     "m1",
     "m3"
    ],
    "compactions": []
   }
  },
